{
  "name": "Youtube Video Scheduler",
  "description": "A browser extension to schedule youtube videos, get playback speed of videos, youtube-shorts controller.",
  "private": true,
  "version": "0.2.5",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.5",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.506.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.5",
    "tw-animate-css": "^1.2.9"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.323",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@wxt-dev/module-react": "^1.1.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4",
    "wxt": "^0.21.5"
  }
}
